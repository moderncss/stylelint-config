{
  "name": "stylelint-config-modern",
  "version": "2.0.0",
  "description": "Modern CSS shareable config for Stylelint",
  "keywords": [
    "modern",
    "stylelint",
    "stylelint-config"
  ],
  "license": "MIT",
  "author": "Richard Hallows",
  "repository": "moderncss/stylelint-config",
  "files": [
    "index.js",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "format": "oxfmt .",
    "check": "run-s check:*",
    "check:format": "oxfmt . --check",
    "check:lint": "oxlint",
    "test": "node --test",
    "watch": "node --test --watch"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.78.0",
    "stylelint": "^18.0.0"
  },
  "peerDependencies": {
    "stylelint": "^18.0.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
