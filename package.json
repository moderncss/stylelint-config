{
  "name": "stylelint-config-modern",
  "version": "1.0.0",
  "description": "Modern CSS shareable config for Stylelint",
  "keywords": [
    "modern",
    "stylelint",
    "stylelint-config"
  ],
  "license": "MIT",
  "author": "Richard Hallows",
  "repository": "moderncss/stylelint-config",
  "files": [
    "index.js"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "format": "oxfmt .",
    "check": "run-s check:*",
    "check:format": "oxfmt . --check",
    "check:lint": "oxlint",
    "test": "node --test",
    "watch": "node --test --watch"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "stylelint": "^17.14.1"
  },
  "peerDependencies": {
    "stylelint": "^17.10.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
